{
  "name": "varbase_media",
  "description": "Manages type of media contents and entity browsers in the site.",
  "private": true,
  "license": "GPL-2.0-or-later",
  "main": "gulpfile.js",
  "engines": {
    "yarn": ">= 4.9.3",
    "node": ">= 20.0"
  },
  "scripts": {
    "theme:init": "gulp",
    "theme:build": "gulp compile && stylelint \"**/*.css\" --fix",
    "theme:watch": "gulp watch",
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --ext .yml .",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:css": "stylelint \"**/*.css\"",
    "spellcheck": "cspell lint ."
  },
  "keywords": [
    "Drupal",
    "Varbase",
    "Drupal profile",
    "Bootstrap"
  ],
  "author": "Vardot",
  "devDependencies": {
    "@babel/core": "~7",
    "@babel/preset-env": "~7",
    "@babel/register": "^7.7.7",
    "autoprefixer": "~9",
    "browser-sync": "~2",
    "chalk": "~2",
    "chokidar": "~3",
    "cross-env": "~5",
    "cspell": "^8.16.1",
    "del": "~3",
    "dotenv-safe": "~5",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jquery": "^1.5.1",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-yml": "^1.18.0",
    "glob": "11.0.0",
    "glob-watcher": "~5",
    "gulp": "~4",
    "gulp-autoprefixer": "~8",
    "gulp-clean-css": "~4",
    "gulp-concat": "~2",
    "gulp-csscomb": "~3",
    "gulp-filter": "~7",
    "gulp-html-replace": "~1",
    "gulp-postcss": "~8",
    "gulp-rename": "~2",
    "gulp-rtlcss": "~1",
    "gulp-sass": "~5",
    "gulp-scss-lint": "~1",
    "gulp-sourcemaps": "~3",
    "gulp-uglify": "~3",
    "merge-stream": "~2",
    "minimatch": "~5",
    "minimist": "^1.2.8",
    "mkdirp": "^3.0.1",
    "postcss": "^8.5.3",
    "postcss-calc": "^7.0.1",
    "postcss-header": "^3.0.3",
    "postcss-import": "^16.1.0",
    "postcss-preset-env": "^10.1.6",
    "postcss-pxtorem": "^6.1.0",
    "postcss-url": "^10.1.3",
    "prettier": "^3.5.3",
    "raw-loader": "^4.0.2",
    "rfs": "~9",
    "sass": "~1",
    "shepherd.js": "~10.0.1",
    "sortablejs": "^1.15.6",
    "stylelint": "^16.19.1",
    "stylelint-checkstyle-formatter": "^0.1.2",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-prettier": "^5.0.2",
    "tabbable": "^6.2.0",
    "terser": "^5.39.0",
    "terser-webpack-plugin": "^5.3.14",
    "underscore": "~1.13.7",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1"
  },
  "//": "'development is the default environment, and legacy is for transpiling the old jQuery codebase",
  "babel": {
    "env": {
      "development": {
        "presets": [
          [
            "@babel/preset-env",
            {
              "modules": "commonjs",
              "targets": {
                "node": "current"
              }
            }
          ]
        ]
      },
      "legacy": {
        "presets": [
          [
            "@babel/preset-env",
            {
              "modules": false
            }
          ]
        ]
      }
    }
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 Edge major versions",
    "last 2 Opera versions",
    "last 2 iOS major versions",
    "last 1 Explorer major version",
    "last 1 ChromeAndroid version",
    "last 1 UCAndroid version",
    "last 1 Samsung version",
    "Firefox ESR"
  ],
  "packageManager": "yarn@4.9.3"
}
